# Empty uses the Next.js Route Handlers on the same origin.
NEXT_PUBLIC_API_URL=

# "enabled" activa Mock Service Worker en el navegador (sin backend real).
NEXT_PUBLIC_API_MOCKING=disabled

# Bloqueo por cambio de pestaña (§13). En v1 solo registra el evento.

# Adaptador HTTP genérico del LLM de decisión. Mantener estas variables solo en el servidor.
DECISION_LLM_URL=
DECISION_LLM_API_KEY=
DECISION_LLM_MODEL=

# Server only. Never prefix these variables with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=alibaba/qwen3.7-flash

# Postgres connection used by better-auth. In your Supabase project, press
# Connect and copy the "Transaction pooler" string, then append sslmode=no-verify
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-your-region.pooler.supabase.com:6543/postgres?sslmode=no-verify

# Generate one with: npx auth@latest secret
BETTER_AUTH_SECRET=your-secret-of-at-least-32-characters
# The URL the app is served from. Use your deployed URL in production.
BETTER_AUTH_URL=http://localhost:3000

# Google Auth Platform > Clients, with this authorized redirect URI:
# {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

NEXT_PUBLIC_DEFAULT_COURSE_ID=bio-101

# Empty uses the Next.js Route Handlers on the same origin.
NEXT_PUBLIC_API_URL=

# "enabled" activa Mock Service Worker en el navegador (sin backend real).
NEXT_PUBLIC_API_MOCKING=disabled

# Bloqueo por cambio de pestaña (§13). En v1 solo registra el evento.
NEXT_PUBLIC_ENABLE_TAB_GUARD=false

# Adaptador HTTP genérico del LLM de decisión. Mantener estas variables solo en el servidor.
DECISION_LLM_URL=
DECISION_LLM_API_KEY=
DECISION_LLM_MODEL=

# Server only. Never prefix these variables with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=alibaba/qwen3.7-flash

NEXT_PUBLIC_DEFAULT_COURSE_ID=bio-101
